<Window x:Class="FastDB.NET_Browser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastDB Browser"
        Width="1440"
        Height="920"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,12,18,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,3,18,7">
                    <TextBlock Text="FastDB" FontSize="22" FontWeight="Bold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Browser" FontSize="22" Margin="7,0,0,0" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Margin="14,0,0,0" Padding="10,4">
                        <TextBlock x:Name="DatabaseBadge" Text="No database" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock x:Name="DatabasePathText" Margin="14,0,0,0" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="620">
                    <Button Content="New" Click="NewDatabase_Click" />
                    <Button Content="Open" Click="OpenDatabase_Click" />
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="SaveDatabase_Click" />
                    <Button Content="Save As" Click="SaveAsDatabase_Click" />
                    <Button Content="Lock" Click="LockDatabase_Click" />
                    <Button Content="Unlock" Click="UnlockDatabase_Click" />
                </WrapPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatsText" Text="0 tables, 0 rows" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="304" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="16">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Tables" FontWeight="Bold" FontSize="15" Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="Schema and row explorer" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="TableSearchBox" Margin="0,14,0,12" TextChanged="TableSearchBox_TextChanged" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Add" Click="AddTable_Click" />
                            <Button Content="Rename" Click="RenameTable_Click" />
                            <Button Content="Delete" Style="{StaticResource DangerButton}" Click="DeleteTable_Click" Margin="0" />
                        </StackPanel>
                    </StackPanel>

                    <ListBox x:Name="TablesList"
                             SelectionChanged="TablesList_SelectionChanged"
                             BorderBrush="{StaticResource LineBrush}"
                             Background="{StaticResource InputBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12">
                                            <Run Text="{Binding Fields, Mode=OneWay}" />
                                            <Run Text=" fields" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="8,3" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding RowsText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Background="{StaticResource AppBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SelectedTableTitle" Text="Select a table" FontSize="22" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                            <TextBlock x:Name="SelectedTableSubtitle" Text="Open or create a database to begin." Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="360">
                            <Button Content="Refresh" Click="Refresh_Click" />
                            <Button Content="Apply edits" Style="{StaticResource PrimaryButton}" Click="ApplyPageEdits_Click" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <TabControl Grid.Row="1" x:Name="MainTabs" BorderThickness="0" Background="{StaticResource AppBrush}">
                    <TabItem Header="Data">
                        <DockPanel Margin="18" Background="{StaticResource AppBrush}">
                            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="First" Click="FirstPage_Click" />
                                        <Button Content="Prev" Click="PreviousPage_Click" />
                                        <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="6,0,14,0" Foreground="{StaticResource MutedBrush}" />
                                        <Button Content="Next" Click="NextPage_Click" />
                                        <Button Content="Last" Click="LastPage_Click" />
                                        <TextBlock Text="Rows/page" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource MutedBrush}" />
                                        <ComboBox x:Name="PageSizeBox" Width="90" SelectionChanged="PageSizeBox_SelectionChanged">
                                            <ComboBoxItem Content="100" IsSelected="True" />
                                            <ComboBoxItem Content="250" />
                                            <ComboBoxItem Content="500" />
                                            <ComboBoxItem Content="1000" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Add row" Click="AddRow_Click" />
                                        <Button Content="Delete selected" Style="{StaticResource DangerButton}" Click="DeleteRows_Click" Margin="0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <DataGrid x:Name="RowsGrid"
                                      AutoGeneratingColumn="RowsGrid_AutoGeneratingColumn"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      IsReadOnly="False" />
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Schema">
                        <Grid Margin="18" Background="{StaticResource AppBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewFieldNameBox" Grid.Column="0" Margin="0,0,10,0" />
                                    <ComboBox x:Name="NewFieldTypeBox" Grid.Column="1" Margin="0,0,10,0" />
                                    <TextBox x:Name="NewFieldDefaultBox" Grid.Column="2" Margin="0,0,10,0" />
                                    <Button Grid.Column="3" Content="Add field" Style="{StaticResource PrimaryButton}" Click="AddField_Click" Margin="0" />
                                </Grid>
                            </Border>
                            <DataGrid x:Name="FieldsGrid" Grid.Row="1" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,10">
                                <Button Content="Remove field" Style="{StaticResource DangerButton}" Click="RemoveField_Click" Margin="0" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Indexes">
                        <Grid Margin="18" Background="{StaticResource AppBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="IndexFieldBox" Width="220" Margin="0,0,10,0" />
                                    <CheckBox x:Name="UniqueIndexBox" Content="Unique" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button Content="Create index" Style="{StaticResource PrimaryButton}" Click="CreateIndex_Click" />
                                    <Button Content="Drop selected" Style="{StaticResource DangerButton}" Click="DropIndex_Click" Margin="0" />
                                </StackPanel>
                            </Border>
                            <DataGrid x:Name="IndexesGrid" Grid.Row="1" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="Exchange">
                        <Grid Margin="18" Background="{StaticResource AppBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Database JSON" FontSize="17" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="Use this for external tools, diffs, and full database edits." TextWrapping="Wrap" Margin="0,6,0,16" Foreground="{StaticResource MutedBrush}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Export JSON" Click="ExportJson_Click" />
                                        <Button Content="Import JSON" Click="ImportJson_Click" Margin="0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Table CSV" FontSize="17" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="Use this for spreadsheet-style edits on the selected table." TextWrapping="Wrap" Margin="0,6,0,16" Foreground="{StaticResource MutedBrush}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Export CSV" Click="ExportCsv_Click" />
                                        <Button Content="Import CSV" Click="ImportCsv_Click" Margin="0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
